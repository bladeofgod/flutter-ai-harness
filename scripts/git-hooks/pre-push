#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo "[pre-push] Codex 适配同步检查"
make codex-adapters-check

echo "[pre-push] Media Capture Wire 生成同步检查"
make media-capture-wire-check

echo "[pre-push] 静态分析"
make analyze

echo "[pre-push] 仓库边界 lint"
make lint

echo "[pre-push] 通过。"
